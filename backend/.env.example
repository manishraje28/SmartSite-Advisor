# ==============================
# SmartSite Backend - Environment Variables
# ==============================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database (MongoDB Atlas) ---
# Get this from: Atlas Dashboard → Your Cluster → Connect → Drivers
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=

# --- Security ---
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated frontend origins. Required when NODE_ENV=production.
CLIENT_ORIGIN=http://localhost:5173

# --- Scoring Engine (Python microservice — see /scoring-engine and PYTHON_SETUP.md) ---
# In development the backend auto-starts this if it isn't already running.
# In production it runs as its own service; point SCORING_ENGINE_URL at it.
SCORING_ENGINE_URL=http://localhost:5001
# Only needed if the Python executable isn't discoverable as `python`/`python3`.
PYTHON_EXECUTABLE=

# --- Live listing scraper (Playwright) ---
# Defaults: on in development, off in production. Needs Chromium installed on the host.
ENABLE_SCRAPER=

# --- LLM agents + maps ---
GROQ_API_KEY=
GOOGLE_MAPS_API_KEY=

# --- Environmental Scoring (OpenWeatherMap free tier) ---
OPENWEATHERMAP_API_KEY=

# --- Google Sign-In (OAuth Web Client ID from Google Cloud Console) ---
# Same value goes in frontend/.env as VITE_GOOGLE_CLIENT_ID — no client secret needed for the ID-token flow.
GOOGLE_CLIENT_ID=
